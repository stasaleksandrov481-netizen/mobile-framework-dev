{
  "name": "cortex-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node --test scripts/telegram-bot.test.mjs scripts/telegram-bot-checkout.test.mjs scripts/telegram-navigation-cache.test.mjs scripts/telegram-avatar.test.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "release:verify": "node scripts/verify-approved-source.mjs",
    "telegram:configure": "node scripts/configure-telegram-bot.mjs",
    "test:telegram-checkout": "node --test scripts/telegram-bot-checkout.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "@supabase/supabase-js": "2.57.0",
    "@upstash/redis": "^1.41.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  }
}
