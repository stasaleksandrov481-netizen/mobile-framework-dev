# Create a dedicated CORTEX database in Upstash. Do not reuse Smetra credentials.
UPSTASH_REDIS_REST_URL=https://your-cortex-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-the-server-only-token

# Supabase public keys for browser authentication (these are not service keys).
NEXT_PUBLIC_CORTEX_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_CORTEX_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Enable only AFTER VK Workspace SMTP and both Supabase email templates are configured.
NEXT_PUBLIC_CORTEX_EMAIL_OTP_READY=false

# Server-only launch notifications; never commit real credentials.
CORTEX_SUPABASE_URL=https://your-project.supabase.co
CORTEX_SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-secret
CORTEX_SMTP_USER=noreply@cortexapp.ru
CORTEX_SMTP_HOST=smtp.mail.ru
CORTEX_SMTP_APP_PASSWORD=replace-with-vk-workspace-app-password
CRON_SECRET=replace-with-long-random-server-secret
CORTEX_BETA_RELEASED=false
CORTEX_BETA_DOWNLOAD_URL=https://cortexapp.ru/replace-with-real-release-url
