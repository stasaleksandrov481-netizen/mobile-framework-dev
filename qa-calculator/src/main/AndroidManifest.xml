<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Test-only separate APK. Never packaged in CORTEX or offered as the installed calculator. -->
    <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="CORTEX QA Calculator" android:allowBackup="false">
        <activity android:name=".SearchActivity" android:exported="true" />
        <activity android:name=".CalculatorActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
